{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:synqoria:clinical-outbox-envelope:v1",
  "title": "SYNQORIA Clinical Outbox Metadata Envelope (Draft)",
  "description": "Transport metadata only. Clinical payload schema, encryption and consent review are separately gated. occurredAt requires canonical RFC3339 timestamp lexical shape even when runtime format-checking extensions are unavailable; calendar-validity checks remain a separate runtime requirement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "tenantId",
    "facilityId",
    "aggregateType",
    "aggregateId",
    "aggregateRevision",
    "eventType",
    "schemaVersion",
    "correlationId",
    "occurredAt"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid"
    },
    "facilityId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{1,79}$"
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateRevision": {
      "type": "integer",
      "minimum": 1
    },
    "eventType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{1,119}$"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 35,
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?(?:Z|[+-](?:0[0-9]|1[0-3]):[0-5][0-9]|[+-]14:00)$"
    }
  }
}
