  "paths": {
    "/api/v1/clinical/patients/{patientId}/encounters/{encounterId}/commands": {
      "post": {
        "summary": "Authenticated clinical command; no client actor/tenant/facility grants",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "patientId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "encounterId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "commandId",
                  "expectedRevision",
                  "operation",
                  "inputs"
                ],
                "properties": {
                  "commandId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "expectedRevision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "operation": {
                    "type": "string",
                    "pattern": "^(encounter|note|observation)\\.[a-z_]{2,60}$"
                  },
                  "inputs": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "maxLength": 8192
                    },
                    "maxProperties": 32
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Idempotent command revision and audit digest"
          },
          "400": {
            "description": "Invalid request envelope"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Unavailable or not disclosed"
          },
          "409": {
            "description": "Stale revision or invalid clinical transition"
          },
          "422": {
            "description": "Malformed or unsupported command"
          },
          "503": {
            "description": "Service unavailable"
          }
        }
      }
    },
