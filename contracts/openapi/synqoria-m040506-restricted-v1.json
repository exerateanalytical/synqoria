    "/api/v1/clinical/patients/{patientId}/encounters/{encounterId}/audit": {
      "get": {
        "summary": "Bounded audit page without clinical note text",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "patientId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "encounterId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "afterRevision",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bounded audit page without clinical note text"
          },
          "400": {
            "description": "Invalid request envelope"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Unavailable or not disclosed"
          },
          "409": {
            "description": "Stale revision or invalid clinical transition"
          },
          "422": {
            "description": "Malformed or unsupported command"
          },
          "503": {
            "description": "Service unavailable"
          }
        }
      }
    },
